{
  "info": {
    "name": "ServiceHub API",
    "description": "API collection for the ServiceHub backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Verify Telegram Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/telegram/callback",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "telegram", "callback"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 12345,\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"username\": \"johndoe\",\n  \"auth_date\": 1787164113,\n  \"hash\": \"dummy_hash\"\n}"
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "Switch Role",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/switch-role",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "switch-role"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"WORKER\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Setup Customer Profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/profile/customer",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "profile", "customer"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bio\": \"Need help with home repairs.\"\n}"
            }
          }
        },
        {
          "name": "Setup Worker Profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/profile/worker",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "profile", "worker"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bio\": \"Expert Plumber\",\n  \"experience\": \"5 years\",\n  \"serviceCategoryIds\": [\n    \"category-id-here\"\n  ]\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "Create Job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/jobs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Fix leaky pipe\",\n  \"description\": \"The kitchen pipe is leaking\",\n  \"categoryId\": \"category-uuid\",\n  \"budget\": 1500\n}"
            }
          }
        },
        {
          "name": "Get Open Jobs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/jobs?status=OPEN",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jobs"],
              "query": [
                {
                  "key": "status",
                  "value": "OPEN"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Initialize Checkout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "checkout"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicationId\": \"app-uuid\"\n}"
            }
          }
        },
        {
          "name": "Chapa Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-chapa-signature",
                "value": "your-signature"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/webhook",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "webhook"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"charge.success\",\n  \"tx_ref\": \"tx-ref-12345\",\n  \"status\": \"success\",\n  \"amount\": \"1500\",\n  \"currency\": \"ETB\"\n}"
            }
          }
        }
      ]
    }
  ]
}
