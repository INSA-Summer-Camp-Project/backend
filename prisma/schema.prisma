// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SystemRole {
  USER
  ADMIN
}

enum ActiveRole {
  CUSTOMER
  WORKER
}

enum Role {
  CUSTOMER
  WORKER
  BUSINESS
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum JobSource {
  POSTING
  DIRECT
}

enum JobStatus {
  OPEN
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DECLINED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum PaymentMethod {
  CASH
  CHAPA
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentProvider {
  CHAPA
}

enum PaymentAccountStatus {
  ACTIVE
  PENDING
  REJECTED
}

model User {
  id             String      @id @default(uuid())
  telegramId     String?     @unique
  name           String
  email          String?
  phone          String?
  passwordHash   String?
  role           Role?       @default(CUSTOMER)
  status         UserStatus? @default(ACTIVE)
  systemRole     SystemRole  @default(USER)
  lastActiveRole ActiveRole?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  customerProfile CustomerProfile?
  customerLegacy  Customer?
  worker          Worker?

  @@index([telegramId])
}

model Customer {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs    Job[]
  reviews Review[]
}

model Worker {
  id              String        @id @default(uuid())
  userId          String        @unique @map("user_id")
  bio             String?       @db.Text
  experienceYears Int           @default(0) @map("experience_years")
  profilePhoto    String?       @map("profile_photo")
  paymentRate     Decimal?      @map("payment_rate") @db.Decimal(10, 2)
  availability    String?
  ratingAvg       Decimal       @default(0.00) @map("rating_avg") @db.Decimal(3, 2)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolios     Portfolio[]
  certificates   Certificate[]
  services       Service[]
  targetedJobs   Job[]          @relation("TargetedJobs")
  assignedJobs   Job[]          @relation("AssignedJobs")
  applications   Application[]
  reviews        Review[]
  paymentAccount PaymentAccount?

  @@map("workers")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?   @db.Text
  services    Service[]
  jobs        Job[]

  @@map("categories")
}

model Service {
  id          String   @id @default(uuid())
  categoryId  String   @map("category_id")
  providerId  String   @map("provider_id")
  name        String
  description String?  @db.Text
  price       Decimal? @db.Decimal(10, 2)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  worker   Worker   @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("services")
}

model Portfolio {
  id          String   @id @default(uuid())
  workerId    String   @map("worker_id")
  title       String
  description String?  @db.Text
  imageUrl    String   @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at")

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@map("portfolios")
}

model Certificate {
  id         String    @id @default(uuid())
  workerId   String    @map("worker_id")
  title      String
  fileUrl    String    @map("file_url")
  issuedDate DateTime? @map("issued_date") @db.Date

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@map("certificates")
}

model Job {
  id               String    @id @default(uuid())
  customerId       String
  targetWorkerId   String?
  source           JobSource @default(POSTING)
  categoryId       String
  title            String
  description      String    @db.Text
  budget           Decimal   @db.Decimal(10, 2)
  status           JobStatus @default(OPEN)
  assignedWorkerId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customer       CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  targetWorker   Worker?         @relation("TargetedJobs", fields: [targetWorkerId], references: [id], onDelete: SetNull)
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  assignedWorker Worker?         @relation("AssignedJobs", fields: [assignedWorkerId], references: [id], onDelete: SetNull)
  applications   Application[]
  payments       Payment[]
  reviews        Review[]

  @@index([customerId])
  @@index([categoryId, status])
  @@index([targetWorkerId])
  @@index([assignedWorkerId])
}

model Application {
  id            String            @id @default(uuid())
  jobId         String
  workerId      String
  proposedPrice Decimal           @db.Decimal(10, 2)
  estimatedTime String
  status        ApplicationStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([jobId, workerId])
  @@index([workerId])
  @@index([jobId])
}

model Payment {
  id                 String        @id @default(uuid())
  jobId              String
  amount             Decimal       @db.Decimal(10, 2)
  currency           String        @default("ETB")
  method             PaymentMethod
  status             PaymentStatus @default(PENDING)
  txRef              String        @unique
  platformCommission Decimal       @db.Decimal(10, 2)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(uuid())
  jobId      String
  workerId   String
  customerId String
  rating     Int
  comment    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  job      Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker   Worker          @relation(fields: [workerId], references: [id], onDelete: Cascade)
  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model PaymentAccount {
  id                String               @id @default(uuid())
  workerProfileId   String               @unique @map("worker_id")
  provider          PaymentProvider
  providerAccountId String
  status            PaymentAccountStatus
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  worker Worker @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
}
