// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SystemRole {
  USER
  ADMIN
}

enum ActiveRole {
  CUSTOMER
  WORKER
}

enum JobSource {
  MARKETPLACE
  DIRECT_HIRE
}

enum JobStatus {
  OPEN
  ASSIGNED
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum PaymentMethod {
  CASH
  CHAPA
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentProvider {
  CHAPA
}

enum PaymentAccountStatus {
  ACTIVE
  PENDING
  REJECTED
}

model User {
  id             String      @id @default(uuid())
  telegramId     String      @unique
  name           String
  systemRole     SystemRole  @default(USER)
  lastActiveRole ActiveRole?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  customerProfile CustomerProfile?
  workerProfile   WorkerProfile?

  @@index([telegramId])
}

model CustomerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs    Job[]
  reviews Review[]
}

model WorkerProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique
  bio                   String
  experience            String
  baseRate              Decimal?
  averageRating         Float    @default(0)
  profileImageUrl       String?
  profileImagePublicId  String?
  verifiedJobCount      Int      @default(0)
  verifiedEarningsTotal Decimal  @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  services       WorkerService[]
  targetedJobs   Job[]           @relation("DirectHires")
  assignedJobs   Job[]           @relation("AssignedJobs")
  applications   Application[]
  reviews        Review[]
  portfolioItems PortfolioItem[]
  certificates   Certificate[]
  paymentAccount PaymentAccount?
}

model ServiceCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workers WorkerService[]
  jobs    Job[]
}

model WorkerService {
  workerProfileId String
  categoryId      String

  worker   WorkerProfile   @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([workerProfileId, categoryId])
}

model Job {
  id               String    @id @default(uuid())
  customerId       String
  targetWorkerId   String?
  source           JobSource
  categoryId       String
  title            String
  description      String
  budget           Decimal
  status           JobStatus @default(OPEN)
  assignedWorkerId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customer       CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  targetWorker   WorkerProfile?  @relation("DirectHires", fields: [targetWorkerId], references: [id], onDelete: SetNull)
  category       ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  assignedWorker WorkerProfile?  @relation("AssignedJobs", fields: [assignedWorkerId], references: [id], onDelete: SetNull)
  applications   Application[]
  payments       Payment[]
  reviews        Review[]
}

model Application {
  id            String            @id @default(uuid())
  jobId         String
  workerId      String
  proposedPrice Decimal
  estimatedTime String
  status        ApplicationStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  job    Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

model Payment {
  id                 String        @id @default(uuid())
  jobId              String
  amount             Decimal
  currency           String        @default("ETB")
  method             PaymentMethod
  status             PaymentStatus @default(PENDING)
  txRef              String        @unique
  platformCommission Decimal
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(uuid())
  jobId      String
  workerId   String
  customerId String
  rating     Int
  comment    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  job      Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker   WorkerProfile   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model PortfolioItem {
  id            String   @id @default(uuid())
  workerId      String
  title         String
  description   String
  imageUrl      String
  imagePublicId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  worker WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

model Certificate {
  id           String   @id @default(uuid())
  workerId     String
  title        String
  fileUrl      String
  filePublicId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  worker WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

model PaymentAccount {
  id                String               @id @default(uuid())
  workerProfileId   String               @unique
  provider          PaymentProvider
  providerAccountId String
  status            PaymentAccountStatus
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
}
