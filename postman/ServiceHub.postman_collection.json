{
  "info": {
    "name": "ServiceHub Backend API",
    "description": "Complete API collection for ServiceHub backend.\n\n## Quick Start\n1. Import the ServiceHub Environment file\n2. Set the environment to 'ServiceHub Local'\n3. Start with Health Check to verify server is running\n4. Use Telegram Login to authenticate (redirects to Telegram OIDC)\n5. After login, the auth token is saved automatically via Tests script\n\n## Auth Flow\n- Most endpoints require a Bearer token\n- The collection has a Tests script that auto-saves the token after login\n- For manual testing, paste the JWT into the `auth_token` variable",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "{{baseUrl}}/api/v1",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Check server and database connectivity. Returns 200 if healthy, 503 if DB is down."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Authentication endpoints. Login via Telegram OIDC, manage session and roles.",
      "item": [
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "description": "Returns the currently authenticated user profile including customer/worker profiles."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has user data', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.be.true;",
                  "  pm.expect(json.data).to.have.property('id');",
                  "  pm.expect(json.data).to.have.property('name');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Active Role",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/auth/role",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "role"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"activeRole\": \"CUSTOMER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Switch active role between CUSTOMER and WORKER. This determines which features are accessible."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "Clears the authentication cookie and invalidates the session."
          },
          "response": []
        },
        {
          "name": "Telegram Login (Redirect)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/telegram",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "telegram"]
            },
            "description": "Initiates Telegram OIDC login flow. Opens Telegram for authentication. After callback, the token is set via cookie.\n\nNote: This redirects to Telegram. To get a token manually, use the browser or run the backend and complete the OAuth flow.",
            "auth": null
          },
          "response": []
        }
      ]
    },
    {
      "name": "Categories",
      "description": "Public service category endpoints.",
      "item": [
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/categories/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories", ""]
            },
            "description": "Returns all service categories. No authentication required.",
            "auth": null
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns array of categories', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.be.true;",
                  "  pm.expect(json.data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Workers",
      "description": "Public worker directory endpoints.",
      "item": [
        {
          "name": "Get All Workers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/workers/?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "workers", ""],
              "query": [
                { "key": "page", "value": "1", "description": "Page number" },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Items per page (max 50)"
                }
              ]
            },
            "description": "Returns paginated list of worker profiles. No authentication required.",
            "auth": null
          },
          "response": []
        },
        {
          "name": "Get Worker By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/workers/{{worker_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "workers", "{{worker_id}}"]
            },
            "description": "Returns a single worker profile by ID. No authentication required.",
            "auth": null
          },
          "response": []
        }
      ]
    },
    {
      "name": "Jobs",
      "description": "Job posting, browsing, and management. Customers create jobs, workers browse and apply.",
      "item": [
        {
          "name": "Get Public Jobs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/jobs/public?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "jobs", "public"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Returns paginated list of open jobs visible to workers. No authentication required.",
            "auth": null
          },
          "response": []
        },
        {
          "name": "Create Job",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data.id) {",
                  "    pm.collectionVariables.set('created_job_id', json.data.id);",
                  "    console.log('Saved job_id:', json.data.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/jobs/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "jobs", ""]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Fix leaking kitchen faucet\",\n  \"description\": \"My kitchen faucet has been dripping for 2 days. Need a plumber to fix or replace it urgently.\",\n  \"categoryId\": \"{{category_id}}\",\n  \"budget\": 1500\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Create a new job posting. Requires CUSTOMER active role.\n\n categoryId: Get from Categories > Get All Categories first."
          },
          "response": []
        },
        {
          "name": "Get My Customer Jobs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/jobs/customer/jobs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "jobs", "customer", "jobs"]
            },
            "description": "Returns all jobs posted by the authenticated customer."
          },
          "response": []
        },
        {
          "name": "Get Worker Available Jobs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/jobs/worker/jobs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "jobs", "worker", "jobs"]
            },
            "description": "Returns jobs available for the authenticated worker to apply to."
          },
          "response": []
        },
        {
          "name": "Get Job By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/jobs/{{created_job_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "jobs", "{{created_job_id}}"]
            },
            "description": "Returns full job details including applications. Optional auth."
          },
          "response": []
        },
        {
          "name": "Update Job Status",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{base_url}}/jobs/{{created_job_id}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "jobs", "{{created_job_id}}", "status"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CANCELLED\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Update job status. Requires CUSTOMER role. Valid statuses: OPEN, ASSIGNED, COMPLETED, CANCELLED."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Applications",
      "description": "Worker applications (bids) on jobs. Workers create/withdraw, customers view/reject.",
      "item": [
        {
          "name": "Create Application (Bid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data.id) {",
                  "    pm.collectionVariables.set('created_application_id', json.data.id);",
                  "    console.log('Saved application_id:', json.data.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/applications/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "applications", ""]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jobId\": \"{{created_job_id}}\",\n  \"proposedPrice\": 1200,\n  \"estimatedTime\": 120\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Submit a bid on a job. Requires WORKER active role.\n\n estimatedTime is in minutes."
          },
          "response": []
        },
        {
          "name": "Get My Worker Applications",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/applications/worker",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "applications", "worker"]
            },
            "description": "Returns all applications submitted by the authenticated worker."
          },
          "response": []
        },
        {
          "name": "Withdraw Application",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/applications/{{created_application_id}}",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "v1",
                "applications",
                "{{created_application_id}}"
              ]
            },
            "description": "Withdraw a pending application. Requires WORKER role. Only PENDING applications can be withdrawn."
          },
          "response": []
        },
        {
          "name": "Get Job Applications (Customer)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/applications/job/{{created_job_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "applications", "job", "{{created_job_id}}"]
            },
            "description": "Returns all applications for a specific job. Requires CUSTOMER role. Only the job owner can view."
          },
          "response": []
        },
        {
          "name": "Reject Application",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/applications/{{created_application_id}}/reject",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "v1",
                "applications",
                "{{created_application_id}}",
                "reject"
              ]
            },
            "description": "Reject a pending application. Requires CUSTOMER role."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Payments",
      "description": "Chapa payment integration. Checkout, webhook, and verification.",
      "item": [
        {
          "name": "Initiate Checkout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data.txRef) {",
                  "    pm.collectionVariables.set('payment_tx_ref', json.data.txRef);",
                  "    console.log('Saved txRef:', json.data.txRef);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/payments/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "checkout"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicationId\": \"{{created_application_id}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Initialize Chapa payment. Requires CUSTOMER role.\n\n Flow: Create job → Worker applies → Customer accepts (triggers checkout) → Redirect to Chapa → Chapa calls webhook → Payment confirmed.\n\n Returns checkout_url to redirect the user."
          },
          "response": []
        },
        {
          "name": "Verify Payment",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/payments/verify/{{payment_tx_ref}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "verify", "{{payment_tx_ref}}"]
            },
            "description": "Manually verify a payment by transaction reference. Useful for debugging."
          },
          "response": []
        },
        {
          "name": "Webhook (Simulate)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/payments/webhook",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "webhook"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "chapa-signature", "value": "{{webhook_signature}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"charge.success\",\n  \"tx_ref\": \"{{payment_tx_ref}}\",\n  \"status\": \"success\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Simulate a Chapa webhook callback. No auth required (uses signature validation).\n\n In production, Chapa calls this endpoint automatically after payment."
          },
          "response": []
        }
      ]
    },
